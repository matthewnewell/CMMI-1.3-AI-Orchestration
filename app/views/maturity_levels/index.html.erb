<div class="row">
  <div class="col-md-10">


    <% @maturity_levels.each do |maturity_level| %>
      <div class="panel panel-primary">
        <div class="panel-heading" >
          <strong> <%= link_to maturity_level.name, maturity_level, {:style=>'color:#FFFFFF;'} %> </strong>
        </div>
        <div class="panel-body">
          <%= truncate(maturity_level.description, length: 1000, separator: ' ') {link_to "continued", maturity_level} %>
        </div>
      </div>
    <% end %>

  </div>
</div>




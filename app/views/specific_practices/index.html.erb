<h1>Specific Practices</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Summary</th>
      <th>Description</th>
      <th>Process area</th>
      <th>Specific goal</th>
    </tr>
  </thead>

  <tbody>
    <% @specific_practices.each do |specific_practice| %>
      <tr>
        <td><%= link_to specific_practice.name, specific_practice %></td>
        <td><%= specific_practice.summary %></td>
        <td><%= specific_practice.description %></td>
        <td><%= link_to specific_practice.specific_goal.process_area.name, process_area_path(specific_practice.specific_goal.process_area_id) %></td>
        <td><%= link_to specific_practice.specific_goal.name, specific_goal_path(specific_practice.specific_goal_id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

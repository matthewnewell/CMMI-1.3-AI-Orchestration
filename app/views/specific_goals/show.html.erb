<div class="panel panel-primary">
  <div class="panel-heading">
  	<%= @specific_goal.name %>  <br>
    <%= markdown(@specific_goal.description) %> 
  </div>
  <div class="panel-body">
    <% @specific_goal.specific_practices.each do |specific_practice| %>
      <p> 
        <%= link_to specific_practice.name, specific_practice_path(specific_practice)%> 
      </p>
    <% end %>
  </div>
</div>



  
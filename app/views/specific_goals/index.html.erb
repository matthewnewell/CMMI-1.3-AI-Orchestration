<h1>Listing specific_goals</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Process area</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @specific_goals.each do |specific_goal| %>
      <tr>
        <td><%= specific_goal.name %></td>
        <td><%= specific_goal.description %></td>
        <td><%= specific_goal.process_area_id %></td>
        <td><%= link_to 'Show', specific_goal %></td>
        <td><%= link_to 'Edit', edit_specific_goal_path(specific_goal) %></td>
        <td><%= link_to 'Destroy', specific_goal, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Specific goal', new_specific_goal_path %>

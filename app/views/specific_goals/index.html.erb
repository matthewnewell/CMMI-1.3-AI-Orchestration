<h1>Specific Goals</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Process area</th>
    </tr>
  </thead>

  <tbody>
    <% @specific_goals.each do |specific_goal| %>
      <tr>
        <td><%= link_to specific_goal.name, specific_goal %></td>
        <td><%= specific_goal.description %></td>
        <td><%= link_to specific_goal.process_area.name, process_area_path(specific_goal.process_area_id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>


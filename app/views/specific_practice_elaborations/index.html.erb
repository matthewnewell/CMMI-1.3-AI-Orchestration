<h1>Listing specific_practice_elaborations</h1>

<table>
  <thead>
    <tr>
      <th>Process area</th>
      <th>Specific practice</th>
      <th>Sp elaboration</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @specific_practice_elaborations.each do |specific_practice_elaboration| %>
      <tr>
        <td><%= specific_practice_elaboration.process_area_id %></td>
        <td><%= specific_practice_elaboration.specific_practice_id %></td>
        <td><%= specific_practice_elaboration.sp_elaboration %></td>
        <td><%= link_to 'Show', specific_practice_elaboration %></td>
        <td><%= link_to 'Edit', edit_specific_practice_elaboration_path(specific_practice_elaboration) %></td>
        <td><%= link_to 'Destroy', specific_practice_elaboration, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>


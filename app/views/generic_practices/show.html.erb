<p id="notice"><%= notice %></p>

<p>
  <strong>Generic goal:</strong>
  <%= link_to @generic_practice.generic_goal.name, generic_goal_path(@generic_practice.generic_goal_id) %>
</p>

<p> <%= link_to "Generic Practices", generic_practices_path %> </p>
<p>
  <strong>Name:</strong>
  <%= @generic_practice.name %>
</p>

<p>
  <strong>Summary:</strong>
  <%= @generic_practice.summary %>
</p>

<p>
  <strong>Description:</strong>
  <%= markdown(@generic_practice.description) %>
</p>

<h3>Generic Practice Elaboration</h3>

<table>
	<tr>
		<th>Process Area</th>
		<th>Elaboration</th>
	</tr>
	<tr>
		<% @generic_practice_elaborations.each do |gpe| %>
			<td> <%= link_to gpe.process_area.name, process_area_path(gpe.process_area) %> </td>
			<td> <%= gpe.gp_elaboration %> </td>
	</tr>
		<% end %>
</table>

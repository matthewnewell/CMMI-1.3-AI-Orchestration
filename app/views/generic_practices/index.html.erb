<h1>Generic Practices</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Summary</th>
    </tr>
  </thead>

  <tbody>
    <% @generic_practices.each do |generic_practice| %>
      <tr>
        <td><%= link_to generic_practice.name, generic_practice %></td>
        <td><%= markdown(generic_practice.summary) %></td>
      </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p id="notice"><%= notice %></p>

<p> <%= link_to "Process Areas",process_areas_path %> </p>

<p>
  <strong>Name:</strong>
  <%= @process_area.name %>
</p>

<p>
  <strong>Purpose:</strong>
  <%= @process_area.purpose %>
</p>

<p>
  <strong>Maturity level:</strong>
  <%= link_to @process_area.maturity_level.name, maturity_level_path(@process_area.maturity_level_id) %>
</p>

<p>
  <strong>Process category:</strong>
  <%= link_to @process_area.process_area_category.name, process_area_category_path(@process_area_category_id) %>
</p>

<h3>Process Area Goals and Practices</h3>

<% @specific_goals.each do |specific_goal| %>
	<h4>
		Specific Goal: <%= specific_goal.name %>
	</h4>
	<table>
		<th>Specific Practice</th>
		<th>Summary</th>
		<th>Description</th>
		<% specific_goal.specific_practices.each do |specific_practice| %>
			<tr>
				<td> <%= link_to markdown(specific_practice.name), specific_practice_path(specific_practice) %> </td>
				<td> <%= markdown(specific_practice.summary) %> </td>
				<td> <%= markdown(specific_practice.description) %> </td>
			</tr>
		<% end %> 
	</table>
<% end %> 

<% @generic_goals.each do |generic_goal| %>
	<h4> Generic Goal: <%= generic_goal.name %> </h4>
	<table>
		<% generic_goal.generic_practices.each do |generic_practice| %>
			<th>Generic Practice</th>
			<th>Process Area Elaboration</th>
			<tr> 
				<td><%= generic_practice.name %></td>
				<% @generic_practice_elaborations.where(generic_practice_id: generic_practice.id).each do |gp_elaboration|  %> 
					<td><%= markdown(gp_elaboration.gp_elaboration) %></td>
				<% end %>
			</tr>
		<% end %>
	</table> 
<% end %>


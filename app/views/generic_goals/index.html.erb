<h1>Listing generic_goals</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @generic_goals.each do |generic_goal| %>
      <tr>
        <td><%= generic_goal.name %></td>
        <td><%= generic_goal.description %></td>
        <td><%= link_to 'Show', generic_goal %></td>
        <td><%= link_to 'Edit', edit_generic_goal_path(generic_goal) %></td>
        <td><%= link_to 'Destroy', generic_goal, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Generic goal', new_generic_goal_path %>

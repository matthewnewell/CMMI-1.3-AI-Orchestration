<div class="panel panel-primary">
  <div class="panel-heading">
    Generic Goals <br> The generic goals are organized in numerical order, GG 1 through GG 3. The generic practices are also organized in numerical order under the generic goal they support.
  </div>
  <div class="panel-body">

        <% @generic_goals.each do |generic_goal| %>
          <%= link_to generic_goal.name, generic_goal %>
          <%= markdown(generic_goal.description) %>
        <% end %>

  </div>
</div>


<h1>Listing generic_practice_elaborations</h1>

<table>
  <thead>
    <tr>
      <th>Process area</th>
      <th>Generic practice</th>
      <th>Gp elaboration</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @generic_practice_elaborations.each do |generic_practice_elaboration| %>
      <tr>
        <td><%= generic_practice_elaboration.process_area_id %></td>
        <td><%= generic_practice_elaboration.generic_practice_id %></td>
        <td><%= generic_practice_elaboration.gp_elaboration %></td>
        <td><%= link_to 'Show', generic_practice_elaboration %></td>
        <td><%= link_to 'Edit', edit_generic_practice_elaboration_path(generic_practice_elaboration) %></td>
        <td><%= link_to 'Destroy', generic_practice_elaboration, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>


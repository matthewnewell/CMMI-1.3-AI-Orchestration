<div class="panel panel-primary">
  <div class="panel-heading">
  	<div class="row">
      <div class="col-md-8">
  		<%= @process_area.name %>
  	  </div>
  	  <div class="col-md-2">
  		Maturity Level
  	  </div>
  	  <div class="col-md-2">
  		Process Category
  	  </div>
  	</div>
  </div>
  <div class="panel-body">
  	<div class="row">
      <div class="col-md-8">
  		<%= @process_area.purpose %>
  	  </div>
  	  <div class="col-md-2">
  		<%= link_to @process_area.maturity_level.name, maturity_level_path(@process_area.maturity_level_id) %>
  	  </div>
  	  <div class="col-md-2">
  		<%= link_to @process_area.process_area_category.name, process_area_category_path(@process_area_category_id) %>
  	  </div>
  	</div>
  </div>
</div>

<% @specific_goals.each do |specific_goal| %>
  <div class="panel panel-primary">
  	<div class="panel-heading">
  	  Specific Goal <%= specific_goal.name %>
  	</div>
  	<div class="panel-body">
  	  <div class="table">
  	  	<table>
	  	  <thead>
  	  	    <tr>
  	  	      <th>Specific Practice</th>
	  	  	<tr>
	  	  </thead>
	  	  <tbody>
	  	  	<% specific_goal.specific_practices.each do |specific_practice| %>
		  	  <tr>
		  	    <td>
		  	      <%= link_to markdown(specific_practice.name), specific_practice_path(specific_practice) %>
		  	    </td>
		  	    <td>
		  	      <%= markdown(specific_practice.summary) %>
		  	    </td>
		  	  </tr>
		    <% end %>
	  	  </tbody>
	  	</table>
	  </div>
	</div>
  </div>
<% end %>


<% @generic_goals.each do |generic_goal| %>
  <div class="panel panel-primary">
  	<div class="panel-heading">
  	  Generic Goal <%= generic_goal.name %>
  	</div>
  	<div class="panel-body">
  	  <div class="table">
  	  	<table>
	  	  <thead>
  	  	    <tr>
  	  	      <th>Generic Practice</th>
	  	  	  <th><%= @process_area.name %> Elaboration</th>
	  	  	<tr>
	  	  </thead>
	  	  <tbody>
	  	  	<% generic_goal.generic_practices.each do |generic_practice| %>
		  	  <tr>
		  	    <td>
		  	      <%= link_to generic_practice.name, generic_practice_path(generic_practice) %>
		  	    </td>
		  	    <td>
		  	      <% @generic_practice_elaborations.where(generic_practice_id: generic_practice.id).each do |gp_elaboration|  %>
		  	        <%= markdown(gp_elaboration.gp_elaboration) %>
		  	      <% end %>
		  	    </td>
		  	  </tr>
		    <% end %>
	  	  </tbody>
	  	</table>
	  </div>
	</div>
  </div>
<% end %>

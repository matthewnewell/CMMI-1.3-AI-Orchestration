<h1>Generic Practice Elaborations</h1>

<table>
  <thead>
    <tr>
      <th>Process area</th>
      <th>Generic practice</th>
      <th>Gp elaboration</th>
    </tr>
  </thead>

  <tbody>
    <% @generic_practice_elaborations.each do |generic_practice_elaboration| %>
      <tr>
        <td><%= link_to generic_practice_elaboration.process_area.name, process_area_path(generic_practice_elaboration.process_area_id) %></td>
        <td><%= link_to generic_practice_elaboration.generic_practice.name, generic_practice_path(generic_practice_elaboration.generic_practice_id) %></td>
        <td><%= generic_practice_elaboration.gp_elaboration %></td>
      </tr>
    <% end %>
  </tbody>
</table>
